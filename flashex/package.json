{
  "name": "flashex",
  "displayName": "FlashEx",
  "description": "Turn natural-language hardware ideas into Arduino project scaffolds with Gemini-assisted planning.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "Arduino",
    "hardware",
    "embedded",
    "Gemini",
    "project scaffolding"
  ],
  "homepage": "https://uvtechstore.in/",
  "repository": {
    "type": "git",
    "url": "https://github.com/SubhakarKaarthi/flashex.git"
  },
  "bugs": {
    "url": "https://github.com/SubhakarKaarthi/flashex/issues"
  },
  "activationEvents": [
    "onCommand:flashex.setupProject"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flashex.setupProject",
        "title": "FlashEx: Set Up Arduino Project"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.136.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
