{
  "name": "FlashEx",
  "short_name": "FlashEx",
  "description": "FlashEx turns natural-language hardware prompts into ready-to-run Arduino projects for rapid prototyping and embedded development.",
  "start_url": "/",
  "scope": "/",
  "id": "flash-ex",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay", "browser"],
  "background_color": "#f7f4f1",
  "theme_color": "#1f5a95",
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "categories": ["developer tools", "productivity", "utilities", "engineering"],
  "prefer_related_applications": false,
  "protocol_handlers": [
    {
      "protocol": "web+flashex",
      "url": "/?source=%s"
    }
  ],
  "screenshots": [
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide",
      "label": "FlashEx dashboard"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "FlashEx mobile project flow"
    }
  ],
  "shortcuts": [
    {
      "name": "Download VSIX",
      "url": "https://github.com/SubhakarKaarthi/flashex/releases/download/v0.0.1/flashex-0.0.1.vsix",
      "description": "Download the FlashEx extension package",
      "icons": [
        { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    }
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
